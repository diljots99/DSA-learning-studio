# Copy to .env.local (never commit it) and fill in from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# These values identify your project; they are not secrets. Security comes from firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development against the Firebase emulators (npm run emulators):
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-dsa
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
# NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
